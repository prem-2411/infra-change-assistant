# Copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=change-me-db-password
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# First admin account, created on startup if it does not exist (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Demo accounts engineer@example.com and approver@example.com (set SEED_DEMO_USERS=false in production)
SEED_DEMO_USERS=true
DEMO_PASSWORD=change-me-demo-password

# Leave empty to run without the LLM: every review then uses the rule-based fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=45
